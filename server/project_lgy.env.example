# Copy to /etc/mseed-server-project_lgy.env and replace every value.
# add-project.sh generates this file automatically with random tokens.
MSEED_PROJECT_NAME=project_lgy
MSEED_DATA_ROOT=/var/lib/mseed-server-projects/project_lgy
MSEED_UPLOAD_TOKEN=replace-with-a-random-upload-token
MSEED_DOWNLOAD_TOKEN=replace-with-a-random-download-token
# Optional dedicated control-plane token. Leave unset to accept the upload
# token (devices) and download token (console) as project tokens.
#MSEED_PROJECT_TOKEN=
# Optional: public URL used in download links when behind HTTPS/Nginx.
#MSEED_PUBLIC_BASE_URL=http://203.0.113.10:9002
